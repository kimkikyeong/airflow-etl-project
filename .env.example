# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 Git에 커밋하지 않습니다)
#   cp .env.example .env

# Oracle SYSTEM 계정 비밀번호 (oracle-db 최초 생성 시 사용)
ORACLE_PWD=

# Airflow 메타데이터 DB(PostgreSQL) 비밀번호
POSTGRES_PASSWORD=

# Airflow Connection 암호화 키 (변경 시 메타데이터 DB에 저장된 비밀번호 복호화 불가)
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# oracle_default Connection (password에는 ORACLE_PWD와 같은 값 입력)
AIRFLOW_CONN_ORACLE_DEFAULT='{"conn_type": "oracle", "host": "oracle-db", "port": 1521, "login": "SYSTEM", "password": "<ORACLE_PWD>", "extra": {"service_name": "FREEPDB1"}}'
